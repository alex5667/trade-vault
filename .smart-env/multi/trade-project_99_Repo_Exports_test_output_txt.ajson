s inside.":[52,52],"#It usually comes from tick side or aggression.":[53,53],"#Adding side to tick":[54,70],"#Adding side to tick#{1}":[55,70],"#1) Validation":[71,76],"#1) Validation#{1}":[72,76],"#2) Tick time policy (must be first: protects downstream detectors)":[77,84],"#2) Tick time policy (must be first: protects downstream detectors)#{1}":[78,84],"#3) Parse remaining tick fields":[85,93],"#3) Parse remaining tick fields#{1}":[86,93],"#4) Context update":[94,98],"#4) Context update#{1}":[95,98],"#P68: build effective cfg (static + dynamic) and apply circuit breaker overrides early.":[99,106],"#P68: build effective cfg (static + dynamic) and apply circuit breaker overrides early.#{1}":[100,106],"#------------------------------------------------------------------":[107,107],"#P68: Determine policy regime. Prefer local indicator states, fallback to dynamic cfg.":[108,108],"#------------------------------------------------------------------[2]":[109,114],"#------------------------------------------------------------------[2]#{1}":[110,114],"#1. Raw mode calculation (P68)":[115,117],"#1. Raw mode calculation (P68)#{1}":[116,117],"#2. Hysteresis check (P69)":[118,118],"#FORCE string to avoid \"Invalid input of type\" error in Redis":[119,121],"#FORCE string to avoid \"Invalid input of type\" error in Redis#{1}":[120,121],"#Need to await? Yes, update is async due to Redis state fetch":[122,124],"#Need to await? Yes, update is async due to Redis state fetch#{1}":[123,124],"#3. Construct EFFECTIVE decision object":[125,127],"#3. Construct EFFECTIVE decision object#{1}":[126,127],"#4. Apply overrides based on EFFECTIVE mode":[128,130],"#4. Apply overrides based on EFFECTIVE mode#{1}":[129,130],"#Apply overrides into effective cfg used by downstream logic":[131,133],"#Apply overrides into effective cfg used by downstream logic#{1}":[132,133],"#Record policy fields for decision record / auditing":[134,136],"#Record policy fields for decision record / auditing#{1}":[135,136],"#P69 enrichment":[137,144],"#P69 enrichment#{1}":[138,144],"#fail-open: do not break tick processing":[145,147],"#fail-open: do not break tick processing#{1}":[146,147],"#--- Delta Detection ---":[148,155],"#--- Delta Detection ---#{1}":[149,155],"#Usually means no significant delta spike":[156,156],"#We return None early unless we are in a mode that processes every tick for continuous metrics":[157,157],"#But the strategy logic relies on delta_event being present for signal generation.":[158,158],"#We check if we should continue anyway (e.g. for pure metrics update?)":[159,159],"#No, standard strategy returns None if no delta spike.":[160,162],"#No, standard strategy returns None if no delta spike.#{1}":[161,162],"#------------------------------------------------------------------[3]":[163,163],"#Authoritative DeltaNotional Tier Gating":[164,164],"#------------------------------------------------------------------[4]":[165,221],"#------------------------------------------------------------------[4]#{1}":[166,221]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:trade-project/99_Repo_Exports/test_output.txt#": {"path":null,"last_embed":{"hash":"yb4pk6","at":1780210345734},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.09730567,0.01223584,-0.00820702,-0.0343462,-0.02125279,-0.0426976,-0.01858533,0.02802637,0.0131042,0.0084591,0.01525185,-0.07709821,0.00473342,0.03956992,-0.05579066,0.00386564,-0.02433419,-0.02663132,-0.061412,0.03904941,0.09629083,-0.05368075,0.00754978,-0.06093157,0.05650844,0.06097117,0.04885644,0.00063942,-0.05949737,-0.23619856,0.02990164,-0.02994126,-0.00222075,-0.00567623,0.02248825,0.05025696,-0.05083103,-0.0667451,-0.02973946,0.05849667,0.05386752,0.02606847,0.02166166,-0.00322112,-0.02819646,-0.04962156,-0.04822714,0.00847833,0.01868516,-0.02700912,-0.00165998,-0.03866176,0.02706601,0.0173728,0.01086723,-0.01275428,0.06061478,0.04551553,0.05805543,0.03934927,0.04714008,0.00015467,-0.21334244,0.05760733,0.