ck (no errors, lower perf at N<500)":[49,52],"#Without cupy: automatic CPU numpy fallback (no errors, lower perf at N<500)#{1}":[50,52],"#GPU-accelerated ML training (Tier-3 nightly train speedup: 10-100x over sklearn)":[53,53],"#xgboost auto-detects CUDA via device='cuda'; CPU fallback if no GPU":[54,55],"#xgboost auto-detects CUDA via device='cuda'; CPU fallback if no GPU#{1}":[55,55],"#LightGBM for ML Scorer V2 (train_ml_scorer.py) — CPU-only, GBDT regressor":[56,57],"#LightGBM for ML Scorer V2 (train_ml_scorer.py) — CPU-only, GBDT regressor#{1}":[57,57],"#cuML (RAPIDS) for GPU Ridge/Scaler — install separately via conda/pip for CUDA env:":[58,58],"#pip install cuml-cu12 --extra-index-url=https://pypi.anaconda.org/rapidsai-nightly/simple":[59,62],"#pip install cuml-cu12 --extra-index-url=https://pypi.anaconda.org/rapidsai-nightly/simple#{1}":[61,62]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:trade-project/99_Repo_Exports/python-worker/requirements.txt#Performance: fast JSON (2-10x vs stdlib) + fast event loop (libuv, 2-4x I/O)": {"path":null,"last_embed":{"hash":"1t9i941","at":1780210730735},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.11208648,0.00186935,0.00222279,-0.03423504,0.03157244,-0.03607064,-0.06858505,0.01933824,0.00626154,0.06151459,0.01105749,-0.03466134,0.03328548,0.00904007,-0.0436092,0.0178625,0.01423224,-0.02402135,-0.02911437,0.05205262,0.01930568,0.01104507,-0.03927939,-0.08487139,0.0377009,0.05796875,-0.00756636,-0.00947222,-0.05094188,-0.2237675,0.04719551,-0.0603871,-0.01644008,-0.00221179,0.03620014,0.00528293,-0.04256505,0.02753661,-0.05994502,0.09915949,-0.00066241,0.04176264,-0.01438392,-0.00928767,-0.01489833,-0.04707079,-0.04059551,0.01088574,0.01776136,-0.02043532,-0.00107016,-0.00304677,-0.00022755,-0.02325901,0.02334612,0.01101398,0.04046834,0.11171892,0.00108992,0.02317835,0.00995654,-0.00150396,-0.16721588,0.10422993,0.05123754,0.01883741,-0.03333897,-0.00371242,0.00830177,0.03339436,-0.1033